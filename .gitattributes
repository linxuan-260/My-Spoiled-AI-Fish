# 这些文件最终要部署到 Linux 服务器，行尾必须是 LF
* text=auto
*.py   text eol=lf
*.sh   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.txt  text eol=lf
*.html text eol=lf
*.js   text eol=lf
*.css  text eol=lf

# 只在 Windows 上跑的本机脚本保持 CRLF
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.vbs  text eol=crlf
